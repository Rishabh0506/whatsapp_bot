# Copy this file to .env and fill in the values. Never commit .env.

# Google AI Studio API key (https://aistudio.google.com/apikey) - the only value needed for now
GEMINI_API_KEY=

# ---- Later, for real WhatsApp only (channel.mode: whatsapp in config/settings.yaml) ----
# Not used by the simulator. Leave these commented out until then.
# WHATSAPP_ACCESS_TOKEN=        Meta App Dashboard > WhatsApp > API Setup
# WHATSAPP_PHONE_NUMBER_ID=     Meta App Dashboard > WhatsApp > API Setup
# WHATSAPP_VERIFY_TOKEN=        any secret string you choose; enter the same one in Meta's webhook settings
# WHATSAPP_APP_SECRET=          Meta App Dashboard > App settings > Basic > App secret
